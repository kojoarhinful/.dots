[init]
	defaultBranch = master

[user]
	name = Bismark Kojo Arhinful
	email = 270801166+kojoarhinful@users.noreply.github.com

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	side-by-side = true
	line-numbers = true
	navigate = true
	light = false

	# "ansi" uses your terminal's 16 colors, so the code in diffs
	# automatically follows the midnight palette set in wezterm.
	syntax-theme = ansi

	# added / removed lines: soft tints, with a stronger tint on the exact words that changed
	plus-style = syntax "#1d2b26"
	plus-emph-style = syntax "#2c4538"
	plus-empty-line-marker-style = normal "#1d2b26"
	minus-style = syntax "#2f2328"
	minus-emph-style = syntax "#573038"
	minus-empty-line-marker-style = normal "#2f2328"

	# moved code (from colorMoved): muted lavender and aqua tints
	map-styles = bold purple => syntax "#2a2640", bold cyan => syntax "#1d3036"

	# line numbers: dim, with the changed ones tinted to match
	line-numbers-left-format = "{nm:^4}"
	line-numbers-right-format = "{np:^4}"
	line-numbers-zero-style = "#4b566b"
	line-numbers-minus-style = "#d9737d"
	line-numbers-plus-style = "#8fa588"
	line-numbers-left-style = "#343c4f"
	line-numbers-right-style = "#343c4f"

	# file and hunk headers: orange file name, dim box around hunks
	file-style = "#ff9a3c" bold
	file-decoration-style = "#ff9a3c" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#343c4f" box
	hunk-header-file-style = "#ff9a3c"
	hunk-header-line-number-style = "#ebcb8b"
	commit-decoration-style = "#343c4f" box
	commit-style = "#ebcb8b" bold

	# dividers between the two sides
	file-modified-label = "changed:"
	right-arrow = "->"

[diff]
	colorMoved = default

[alias]
	lg = log --graph --oneline --decorate --all
