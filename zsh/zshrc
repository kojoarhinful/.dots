# fzf uses fd (fast, respects .gitignore)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --exclude node_modules'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# functions
stuff() {
  # `stuff i` -> jump straight to the space folder
  if [ "$1" = "i" ]; then
    cd "$HOME/space" || return
    return
  fi

  command -v fzf >/dev/null 2>&1 || {
    echo "fzf is not installed"
    return 1
  }

  local dir
  dir=$(find "$HOME/space" -mindepth 1 -maxdepth 1 -type d | fzf) || return
  [ -z "$dir" ] && return

  if [ "$1" = "." ]; then
    cd "$dir" || return
    hx .
  else
    cd "$dir" || return
  fi
}

# find a file by name, preview it, open in helix
ff() {
  command -v fzf >/dev/null 2>&1 || {
    echo "fzf is not installed"
    return 1
  }

  # use bat for a nice preview if installed, otherwise plain head
  local preview
  if command -v bat >/dev/null 2>&1; then
    preview='bat --style=numbers --color=always --line-range=:200 {}'
  else
    preview='head -200 {}'
  fi

  local file
  file=$(fd --type f --hidden --exclude .git --exclude node_modules \
    | fzf --preview "$preview" \
          --preview-window=right:60% \
          --bind 'ctrl-/:toggle-preview') || return
  [ -z "$file" ] && return

  hx "$file"
}

# search INSIDE files: rf <word>, preview the match, open helix at that line
rf() {
  command -v rg >/dev/null 2>&1 || {
    echo "ripgrep is not installed"
    return 1
  }

  local result
  result=$(rg --line-number --no-heading --color=always "${1:-.}" \
    | fzf --ansi --delimiter : \
          --preview 'bat --color=always --highlight-line {2} {1}' \
          --preview-window=right:60%) || return
  [ -z "$result" ] && return

  hx "$(echo "$result" | cut -d: -f1):$(echo "$result" | cut -d: -f2)"
}

regcap() {
  command -v tmux >/dev/null 2>&1 || {
    echo "tmux is not installed"
    return 1
  }

  # If a name was given, use it
  if [ -n "$1" ]; then
    if tmux has-session -t "$1" 2>/dev/null; then
      echo "Session '$1' already exists, attaching."
      tmux attach -t "$1"
    else
      tmux new-session -s "$1"
    fi
    return
  fi

  # Otherwise pick a random free name
  local -a names available
  local city session
  names=(accra kumasi taadi cape koftown ho tamale bolga wa sunyani techiman goaso dambai damongo nalerigu wiawso)
  for city in "${names[@]}"; do
    if ! tmux has-session -t "$city" 2>/dev/null; then
      available+=("$city")
    fi
  done
  if [ "${#available[@]}" -eq 0 ]; then
    echo "All predefined tmux session names are currently in use."
    return 1
  fi
  session=${available[$((RANDOM % ${#available[@]} + 1))]}
  tmux new-session -s "$session"
}

dots() {
  if [ "$1" = "." ]; then
    cd "$HOME/.dots" || return
    hx .
  else
    cd "$HOME/.dots" || return
  fi
}

# aliases
